{
  "name": "grugnettos-kludgopolb",
  "version": "0.11.0-rc.68",
  "private": true,
  "type": "module",
  "description": "Software-archaeology restoration of KludgopolB with an original Grugnetto board.",
  "scripts": {
    "dev": "node scripts/serve.mjs public 8080",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs game 8080",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "sim": "node scripts/simulate.js",
    "arena": "node scripts/arena.js",
    "serve": "node scripts/serve.mjs",
    "calibrate": "node scripts/calibrate-economy.js",
    "landing": "node scripts/landing-frequency.js",
    "qa": "node --test tests/qa-flow.test.js tests/rare-branches.test.js",
    "smoke": "node scripts/http-smoke.mjs",
    "release:check": "npm test && npm run qa && npm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4"
  },
  "license": "GPL-3.0-only"
}
