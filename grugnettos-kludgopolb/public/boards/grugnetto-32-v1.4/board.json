  "economy": {
    "version": "v1",
    "method": "Each world has roughly the same total acquisition cost (~600 coins). Within a world, location prestige is multiplied by empirical landing frequency to distribute prices. Base revenue is then corrected by landing frequency so traffic alone does not make a location dominant.",
    "worldTargetCost": 600,
    "prestigeFactors": [
      0.75,
      0.9,
      1.1,
      1.3
    ],
    "landingCalibration": "2,000,000 simulated turns (500 runs × 4,000), deterministic seeded movement including doubles, themed event v2 movement and Base Camp.",
    "baseRevenueTarget": "about 8.5% of list price, corrected by empirical landing weight",
    "embellishmentCost": "about 45% of list price, rounded to 5 coins",
    "embellishmentCurveMultipliers": [
      1,
      3,
      10,
      24,
      50
    ],
    "note": "Economy v1 uses original Grugnetto pricing and revenue tables. Prices/rents are retained; landingWeight values were refreshed for themed event v2 so the historical AIs evaluate the updated traffic pattern."
  },
  "eventVersion": "2.0-themed",
  "eventDesign": {
    "version": "v2",
    "method": "Two deterministic 8-card decks. Cards are shuffled once per game with the seeded RNG, then cycled without replacement within each 8-card cycle.",
    "themes": "Adventures reward exploration, world ownership and embellishments; Setbacks introduce travel disruption, upkeep and occasional embellishment loss.",
    "note": "Effects are original to the Grugnetto board and are independent of the recovered regional card decks.",
    "balance": "Cash values tuned so the two decks together remain close to economically neutral while preserving non-cash strategic effects."
  },
  "landingWeightVersion": "event-v2 / 2,000,000 simulated turns"
