{
  "name": "grugnettos-klondike",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs public 8080",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs game 8080",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run certify",
    "package:release": "bash scripts/package-release.sh",
    "test:reference": "node --test tests/reference-engine.test.mjs tests/original-oracle.test.mjs",
    "certify": "node --test tests/original-oracle.test.mjs tests/cross-certification.test.mjs",
    "certify:random": "node scripts/certify-random-deals.mjs 100 certification/random-deals-latest.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4"
  },
  "type": "module",
  "displayName": "Grugnetto’s Klondike"
}
