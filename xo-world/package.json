{
  "name": "xo-world",
  "version": "1.0.0",
  "private": true,
  "description": "XO World: the 2007 five-in-a-row Java applet by Milan Babuskov, ported to HTML5 with its original CPU logic.",
  "scripts": {
    "dev": "node scripts/serve.mjs public 8080",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs game 8080",
    "test": "node --test test/*.test.js",
    "test:live": "node tools/java-oracle.js check",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "bundle": "node tools/build-browser.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-or-later",
  "displayName": "XO World"
}
