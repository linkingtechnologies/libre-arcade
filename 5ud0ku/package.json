{
  "name": "5ud0ku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "5ud0ku: the Java ME Sudoku game by Ive&Case (2006) with its own generator and solvers, ported to the browser.",
  "scripts": {
    "dev": "node scripts/serve.mjs public 8080",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs game 8080",
    "test": "node --test test/*.test.js",
    "test:live": "node tools/java-oracle.mjs check",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-or-later",
  "displayName": "5ud0ku"
}
