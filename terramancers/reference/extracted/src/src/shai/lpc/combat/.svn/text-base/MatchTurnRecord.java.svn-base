/**
 * The record of a single turn from a match, including all dice rolls. Everything that happens in a turn goes into the action record,
 * so that together they constitute a replay on the match, that can be used to recreate it accurately.
 * Every turn record contains the action every player took, each of their dice rolls, and any spontaneous events.
 * @author Shai Shapira
 *
 */
public class MatchTurnRecord {
	
	public MatchTurnRecord(String action) {
		System.out.println(action);
	}

}
