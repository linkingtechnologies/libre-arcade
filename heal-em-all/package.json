{
  "name": "heal-em-all",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heal'em All (Krzysztof Urbas and Pawel Madeja, GitHub Game Off 2013), restored for the browser.",
  "scripts": {
    "dev": "node scripts/serve.mjs public 8080",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs game 8080",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-only",
  "displayName": "Heal'em All"
}
