    #include <SDL.h>
    #include "cube.h"
    #include "font.h"
    #include "soundDev.h"
    #include "view.h"
    #include "bombView.h"
    #include "bomb.h"
@

Then, the source file incorporates the implementation of the
constructor.
<<bomb.cpp>>=
    <<BombSquad Constructor Implementation>>
@

After that, the source file incorporates the implementation of the
reset method.
<<bomb.cpp>>=
    <<BombSquad Reset Implementation>>
@

The source file also contains the implementation of the
uncover-a-cell method and the toggle-the-flag-state method
<<bomb.cpp>>=
